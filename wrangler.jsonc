{
  "name": "portfolio",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  // Chỉ đưa trang lên web: chép index.html, assets/, blog/, havvking/, pham-viet-ha/, sitemap.xml, robots.txt, khoá IndexNow vào dist/ trước mỗi lần deploy
  // (worker.js, README, bản cũ không lộ ra ngoài). GitHub Pages vẫn phục vụ thẳng từ gốc repo.
  "build": { "command": "rm -rf dist && mkdir -p dist && cp -r index.html assets blog havvking pham-viet-ha sitemap.xml *.txt dist/" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}
