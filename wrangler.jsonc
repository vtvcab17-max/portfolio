{
  "name": "portfolio",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  // Chỉ đưa trang lên web: chép index.html và assets/ vào dist/ trước mỗi lần deploy
  // (worker.js, README, bản cũ không lộ ra ngoài). GitHub Pages vẫn phục vụ thẳng từ gốc repo.
  "build": { "command": "rm -rf dist && mkdir -p dist && cp -r index.html assets dist/" },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
}
